# ==========================================
# DEPENDENCIES
# ==========================================

# Node.js dependencies - these are downloaded packages that can be restored via npm install
node_modules/

# ==========================================
# BUILD OUTPUTS
# ==========================================

# TypeScript compiled output - regenerated on build
dist/
dist-ssr/

# Vite build output directory
build/

# TypeScript incremental compilation cache
*.tsbuildinfo

# ==========================================
# ENVIRONMENT & SECRETS
# ==========================================

# Environment variable files containing API keys, database credentials, and other secrets
# CRITICAL: These files may contain ANTHROPIC_API_KEY and other sensitive credentials
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local

# ==========================================
# LOGS
# ==========================================

# Application and package manager logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# OPERATING SYSTEM FILES
# ==========================================

# macOS Finder metadata
.DS_Store

# Windows thumbnail cache
Thumbs.db
ehthumbs.db

# Linux trash folder
.Trash-*

# ==========================================
# EDITOR & IDE FILES
# ==========================================

# VS Code settings (allow extensions.json for recommended extensions)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains IDEs (WebStorm, IntelliJ)
.idea/

# Vim/Neovim swap and backup files
*.sw?
*.swp
*.swo
*~

# Visual Studio files
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# Sublime Text
*.sublime-workspace

# ==========================================
# TESTING & COVERAGE
# ==========================================

# Test coverage reports - generated on test runs
coverage/
.nyc_output/

# Playwright test results
/test-results/
/playwright-report/
/playwright/.cache/

# Vitest coverage
vitest.coverage/

# ==========================================
# CACHING
# ==========================================

# ESLint cache
.eslintcache

# Prettier cache
.prettiercache

# Parcel bundler cache
.parcel-cache/

# Vite cache
.vite/

# Turborepo cache
.turbo/

# Next.js (in case you add it)
.next/
out/

# Nuxt.js (in case you add it)
.nuxt/
.output/

# ==========================================
# PACKAGE MANAGER FILES
# ==========================================

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# pnpm
.pnpm-store/

# ==========================================
# MISC SENSITIVE/LOCAL FILES
# ==========================================

# Local configuration files
*.local

# SSH keys (should never be in repo)
*.pem
*.key
id_rsa*
id_ed25519*

# Certificate files
*.crt
*.cer
*.p12
*.pfx

# Database files (local SQLite, etc.)
*.db
*.sqlite
*.sqlite3

# Credentials and secrets files
credentials.json
secrets.json
*-credentials.json
*-secrets.json
service-account*.json

# AWS credentials
.aws/

# Docker environment files with secrets
docker-compose.override.yml

# Terraform state (if you use infrastructure as code)
*.tfstate
*.tfstate.*
.terraform/

# ==========================================
# DEBUGGING & TEMPORARY FILES
# ==========================================

# Debug output
*.debug

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Backup files
*.bak
*.backup

# ==========================================
# VERCEL/DEPLOYMENT
# ==========================================

# Vercel
.vercel/

# Netlify
.netlify/

# ==========================================
# MISCELLANEOUS
# ==========================================

# Lock files for other package managers (keep package-lock.json for npm)
# Uncomment if you want to ignore lock files
# yarn.lock
# pnpm-lock.yaml

# Generated API documentation
docs/api/
api-docs/

# Storybook build output
storybook-static/
